{
  "id": "pypi_setup_install_credential_exfiltration",
  "name": Wrap Git revision swap",
   "name": "PyPI install-time credential exfiltration",
  "description": "Model a compromised or hijacked Python package executing malicious setup.py logic during installation to access and exfiltrate sensitive credentials and environment variables.",
  "target_build_phase": "dependency_fetch",
  "scheme": "dependency_aware",
  "mode": "insert_after",
  "injection_location": {
    "file_glob": "setup.py",
    "field": "install_hook"
  },
  "placeholders": {
    "SETUP_FILE": "relative path to the package's setup.py file",
    "INSTALL_HOOK": "existing installation-time execution point or supported insertion anchor"
  },
  "attacker_values": {
    "MALICIOUS_INSTALL_LOGIC": "ATTACKER_CONTROLLED_CREDENTIAL_COLLECTION_AND_EXFILTRATION_LOGIC"
  },
  "template": {
    "file_path": "{{SETUP_FILE}}",
    "anchor": "{{INSTALL_HOOK}}",
    "replacement_value": "{{MALICIOUS_INSTALL_LOGIC}}"
  },
  "preconditions": [
    "project installs a Python package whose installation process executes setup.py or an equivalent build hook",
    "the package source or distribution can be replaced or modified by an attacker",
    "the operator engine supports the specified install_hook locator and insert_after mode",
    "credentials or sensitive environment variables are accessible to the installation process"
  ],
  "source_attacks": [
    "PyPI ctx & phpass (2022)"
  ]
}
