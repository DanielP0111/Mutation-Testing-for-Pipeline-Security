project('guarded', 'c', version : '2.0')

# Depth-1 conditional
if host_machine.system() == 'linux'
  linux_dep = dependency('liburing', required : true)

  # Depth-2 conditional (nested)
  if get_option('feature-x')
    extra_dep = dependency('libfoo', required : false)
  elif get_option('feature-y')
    extra_dep = dependency('libbar', required : false)
  endif

endif

# Another depth-1 block
if host_machine.system() == 'windows'
  win_dep = dependency('ws2_32', required : true)
endif

executable('guarded', 'guarded.c')
